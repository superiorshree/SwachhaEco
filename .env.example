# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# Pune Municipal Corporation • Smart Waste & Resource Recovery Portal
# ==============================================================================

# Port for local HTTP server (Default: 8080)
PORT=8080

# ------------------------------------------------------------------------------
# SUPABASE CLOUD DATABASE CONFIGURATION (RECOMMENDED FOR VERCEL)
# ------------------------------------------------------------------------------
# When these two variables are provided, the platform automatically connects
# to your Supabase PostgreSQL cloud database.
# If omitted, the platform gracefully falls back to local SQLite (smartwaste.db).
#
# Obtain these from: Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Service Role Key (bypasses RLS for backend operations)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
